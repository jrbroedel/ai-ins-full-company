<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_luxauto_policy_vehicle_list" model="ir.ui.view">
        <field name="name">luxauto.policy.vehicle.list</field>
        <field name="model">luxauto.policy.vehicle</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false" import="false">
                <field name="vin"/>
                <field name="year"/>
                <field name="make"/>
                <field name="model"/>
                <field name="vehicle_category"/>
                <field name="garaging_state"/>
            </list>
        </field>
    </record>

    <record id="view_luxauto_policy_vehicle_form" model="ir.ui.view">
        <field name="name">luxauto.policy.vehicle.form</field>
        <field name="model">luxauto.policy.vehicle</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group string="Vehicle">
                            <field name="vin"/>
                            <field name="year"/>
                            <field name="make"/>
                            <field name="model"/>
                            <field name="trim"/>
                            <field name="vehicle_category"/>
                        </group>
                        <group string="Coverage">
                            <field name="garaging_state"/>
                            <field name="agreed_value_requested"/>
                            <field name="current_appraised_value"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_luxauto_policy_vehicle" model="ir.actions.act_window">
        <field name="name">Policy Vehicles</field>
        <field name="res_model">luxauto.policy.vehicle</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
