<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add an underwriter (calls add_underwriter). -->
    <record id="view_luxauto_underwriter_add_wizard_form" model="ir.ui.view">
        <field name="name">luxauto.underwriter.add.wizard.form</field>
        <field name="model">luxauto.underwriter.add.wizard</field>
        <field name="arch" type="xml">
            <form>
                <p>Add a new underwriter to the roster.</p>
                <group>
                    <field name="name"/>
                    <field name="authority_level"/>
                </group>
                <footer>
                    <button string="Add" type="object" name="action_add" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_luxauto_underwriter_add_wizard" model="ir.actions.act_window">
        <field name="name">Add Underwriter</field>
        <field name="res_model">luxauto.underwriter.add.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Update an underwriter: promote/demote, (de)activate, rename (calls
         update_underwriter). Blank fields are left unchanged; the DB rejects an
         all-unchanged update with a clear message. -->
    <record id="view_luxauto_underwriter_update_wizard_form" model="ir.ui.view">
        <field name="name">luxauto.underwriter.update.wizard.form</field>
        <field name="model">luxauto.underwriter.update.wizard</field>
        <field name="arch" type="xml">
            <form>
                <p>
                    Update an underwriter. Leave a field blank to keep its current
                    value. Use Active Status to (de)activate.
                </p>
                <group>
                    <field name="underwriter"/>
                    <field name="new_name"/>
                    <field name="new_authority_level"/>
                    <field name="active_action"/>
                </group>
                <footer>
                    <button string="Update" type="object" name="action_update" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_luxauto_underwriter_update_wizard" model="ir.actions.act_window">
        <field name="name">Update Underwriter</field>
        <field name="res_model">luxauto.underwriter.update.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
