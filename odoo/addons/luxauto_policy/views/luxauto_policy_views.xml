<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_luxauto_policy_list" model="ir.ui.view">
        <field name="name">luxauto.policy.list</field>
        <field name="model">luxauto.policy</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false" import="false">
                <field name="policy_number"/>
                <field name="policy_status"/>
                <field name="premium_amount"/>
                <field name="quote_status"/>
                <field name="garaging_state"/>
                <field name="application_status"/>
            </list>
        </field>
    </record>

    <record id="view_luxauto_policy_form" model="ir.ui.view">
        <field name="name">luxauto.policy.form</field>
        <field name="model">luxauto.policy</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <header>
                    <button string="Cancel Policy" type="object" name="action_open_cancel_wizard"
                            class="btn-danger" invisible="policy_status != 'active'"/>
                </header>
                <sheet>
                    <group>
                        <group string="Policy">
                            <field name="policy_number"/>
                            <field name="policy_status"/>
                        </group>
                        <group string="Quote">
                            <field name="quote_id"/>
                            <field name="premium_amount"/>
                            <field name="quote_status"/>
                        </group>
                    </group>
                    <group string="Application">
                        <field name="application_id"/>
                        <field name="garaging_state"/>
                        <field name="application_status"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_luxauto_policy" model="ir.actions.act_window">
        <field name="name">Policies</field>
        <field name="res_model">luxauto.policy</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
