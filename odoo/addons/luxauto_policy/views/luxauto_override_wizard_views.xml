<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Launched from the review-queue row's "Authorize Override" button, which
         pre-fills application_id + overridden_action via context. No menu item:
         it always opens against a specific flagged application. -->
    <record id="view_luxauto_override_wizard_form" model="ir.ui.view">
        <field name="name">luxauto.override.wizard.form</field>
        <field name="model">luxauto.override.wizard</field>
        <field name="arch" type="xml">
            <form>
                <p>
                    Authorize a supervised release of this flagged application. The
                    authority requirement (a senior underwriter is required for a
                    MANUAL_REVIEW_SENIOR disposition) and the active-underwriter
                    check are enforced by the database - an unauthorized attempt is
                    refused with a clear message, nothing is written.
                </p>
                <group>
                    <field name="application_id"/>
                    <field name="overridden_action"/>
                    <field name="underwriter"/>
                    <field name="reason"/>
                </group>
                <footer>
                    <button string="Authorize Override" type="object" name="action_authorize" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
