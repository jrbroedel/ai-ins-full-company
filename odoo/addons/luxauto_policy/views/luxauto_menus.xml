<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <menuitem id="menu_luxauto_root" name="Luxury Auto" sequence="50"/>

    <menuitem id="menu_luxauto_bind_wizard"
              name="Bind a Quote"
              parent="menu_luxauto_root"
              action="action_luxauto_bind_wizard"
              sequence="5"/>

    <menuitem id="menu_luxauto_insured"
              name="Insureds"
              parent="menu_luxauto_root"
              action="action_luxauto_insured"
              sequence="10"/>

    <menuitem id="menu_luxauto_policy"
              name="Policies"
              parent="menu_luxauto_root"
              action="action_luxauto_policy"
              sequence="20"/>

    <menuitem id="menu_luxauto_policy_vehicle"
              name="Policy Vehicles"
              parent="menu_luxauto_root"
              action="action_luxauto_policy_vehicle"
              sequence="22"/>

    <menuitem id="menu_luxauto_policy_driver"
              name="Policy Drivers"
              parent="menu_luxauto_root"
              action="action_luxauto_policy_driver"
              sequence="24"/>

    <!-- Grouped with the other read-only policy-side views rather than next to
         the cancel wizard: this reads cancellations back, it does not perform
         one (ADR 0018 addendum). -->
    <menuitem id="menu_luxauto_policy_cancellation"
              name="Policy Cancellations"
              parent="menu_luxauto_root"
              action="action_luxauto_policy_cancellation"
              sequence="26"/>

    <menuitem id="menu_luxauto_premium_waterfall"
              name="Premium Waterfall"
              parent="menu_luxauto_root"
              action="action_luxauto_premium_waterfall"
              sequence="30"/>

    <!-- groups= hides the menu item itself for non-members, on top of the
         model-level access rights (ir.model.access.csv) that are the real
         enforcement boundary - belt and suspenders, not a substitute. -->
    <menuitem id="menu_luxauto_settlement"
              name="Settlement Report"
              parent="menu_luxauto_root"
              action="action_luxauto_settlement"
              groups="luxauto_policy.group_settlement_viewer"
              sequence="40"/>

</odoo>
