<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <menuitem id="menu_luxauto_root" name="Luxury Auto" sequence="50"/>

    <menuitem id="menu_luxauto_bind_wizard"
              name="Bind a Quote"
              parent="menu_luxauto_root"
              action="action_luxauto_bind_wizard"
              sequence="5"/>

    <!-- ADR 0040 underwriter override UI. The review queue leads (it is the
         actionable screen); the roster and its add/update wizards sit lower. All
         open to base.group_user for now - a dedicated underwriting group is a
         tracked follow-up (see ADR 0040). -->
    <menuitem id="menu_luxauto_underwriter_review"
              name="Underwriter Review Queue"
              parent="menu_luxauto_root"
              action="action_luxauto_underwriter_review"
              sequence="6"/>

    <menuitem id="menu_luxauto_underwriter"
              name="Underwriters"
              parent="menu_luxauto_root"
              action="action_luxauto_underwriter"
              sequence="42"/>

    <menuitem id="menu_luxauto_underwriter_add"
              name="Add Underwriter"
              parent="menu_luxauto_root"
              action="action_luxauto_underwriter_add_wizard"
              sequence="43"/>

    <menuitem id="menu_luxauto_underwriter_update"
              name="Update Underwriter"
              parent="menu_luxauto_root"
              action="action_luxauto_underwriter_update_wizard"
              sequence="44"/>

    <menuitem id="menu_luxauto_insured"
              name="Insureds"
              parent="menu_luxauto_root"
              action="action_luxauto_insured"
              sequence="10"/>

    <menuitem id="menu_luxauto_policy"
              name="Policies"
              parent="menu_luxauto_root"
              action="action_luxauto_policy"
              sequence="20"/>

    <menuitem id="menu_luxauto_policy_vehicle"
              name="Policy Vehicles"
              parent="menu_luxauto_root"
              action="action_luxauto_policy_vehicle"
              sequence="22"/>

    <menuitem id="menu_luxauto_policy_driver"
              name="Policy Drivers"
              parent="menu_luxauto_root"
              action="action_luxauto_policy_driver"
              sequence="24"/>

    <!-- Grouped with the other read-only policy-side views rather than next to
         the cancel wizard: this reads cancellations back, it does not perform
         one (ADR 0018 addendum). -->
    <menuitem id="menu_luxauto_policy_cancellation"
              name="Policy Cancellations"
              parent="menu_luxauto_root"
              action="action_luxauto_policy_cancellation"
              sequence="26"/>

    <!-- ADR 0029 read-side visibility. Standalone siblings under the same root,
         consistent with the flat, no-notebook house style every other read view
         here follows; the referral summary and detail sit next to each other. -->
    <menuitem id="menu_luxauto_policy_reinstatement"
              name="Policy Reinstatements"
              parent="menu_luxauto_root"
              action="action_luxauto_policy_reinstatement"
              sequence="27"/>

    <menuitem id="menu_luxauto_short_rate_factor"
              name="Short-Rate Factors"
              parent="menu_luxauto_root"
              action="action_luxauto_short_rate_factor"
              sequence="28"/>

    <menuitem id="menu_luxauto_premium_waterfall"
              name="Premium Waterfall"
              parent="menu_luxauto_root"
              action="action_luxauto_premium_waterfall"
              sequence="30"/>

    <menuitem id="menu_luxauto_application_referral"
              name="Application Referrals"
              parent="menu_luxauto_root"
              action="action_luxauto_application_referral"
              sequence="32"/>

    <menuitem id="menu_luxauto_decision_log"
              name="Referral Decision Log"
              parent="menu_luxauto_root"
              action="action_luxauto_decision_log"
              sequence="34"/>

    <menuitem id="menu_luxauto_quote_commission"
              name="Quote Commissions"
              parent="menu_luxauto_root"
              action="action_luxauto_quote_commission"
              sequence="36"/>

    <menuitem id="menu_luxauto_quote_rating"
              name="Quote Ratings"
              parent="menu_luxauto_root"
              action="action_luxauto_quote_rating"
              sequence="38"/>

    <!-- groups= hides the menu item itself for non-members, on top of the
         model-level access rights (ir.model.access.csv) that are the real
         enforcement boundary - belt and suspenders, not a substitute. -->
    <menuitem id="menu_luxauto_settlement"
              name="Settlement Report"
              parent="menu_luxauto_root"
              action="action_luxauto_settlement"
              groups="luxauto_policy.group_settlement_viewer"
              sequence="40"/>

</odoo>
