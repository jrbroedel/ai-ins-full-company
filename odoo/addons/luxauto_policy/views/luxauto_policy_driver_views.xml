<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_luxauto_policy_driver_list" model="ir.ui.view">
        <field name="name">luxauto.policy.driver.list</field>
        <field name="model">luxauto.policy.driver</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false" import="false">
                <field name="name"/>
                <field name="relationship_to_applicant"/>
                <field name="date_of_birth"/>
                <field name="license_status"/>
                <field name="violations_last_5yr"/>
                <field name="at_fault_accidents_last_5yr"/>
            </list>
        </field>
    </record>

    <record id="view_luxauto_policy_driver_form" model="ir.ui.view">
        <field name="name">luxauto.policy.driver.form</field>
        <field name="model">luxauto.policy.driver</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group string="Driver">
                            <field name="name"/>
                            <field name="relationship_to_applicant"/>
                            <field name="date_of_birth"/>
                            <field name="years_licensed"/>
                            <field name="license_status"/>
                        </group>
                        <group string="History">
                            <field name="violations_last_5yr"/>
                            <field name="at_fault_accidents_last_5yr"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_luxauto_policy_driver" model="ir.actions.act_window">
        <field name="name">Policy Drivers</field>
        <field name="res_model">luxauto.policy.driver</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
