<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_luxauto_settlement_list" model="ir.ui.view">
        <field name="name">luxauto.settlement.list</field>
        <field name="model">luxauto.settlement</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false" import="false">
                <field name="transaction_date"/>
                <field name="transaction_type"/>
                <field name="bind_date" optional="hide"/>
                <field name="policy_number"/>
                <field name="policy_status"/>
                <field name="participant_name"/>
                <field name="participant_type"/>
                <field name="share_percentage"/>
                <field name="commission_rate"/>
                <field name="gross_share"/>
                <field name="commission_amount"/>
                <field name="net_due"/>
            </list>
        </field>
    </record>

    <record id="view_luxauto_settlement_form" model="ir.ui.view">
        <field name="name">luxauto.settlement.form</field>
        <field name="model">luxauto.settlement</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group string="Policy">
                            <field name="policy_number"/>
                            <field name="policy_status"/>
                            <field name="transaction_type"/>
                            <field name="transaction_date"/>
                            <field name="bind_date"/>
                        </group>
                        <group string="Participant">
                            <field name="participant_name"/>
                            <field name="participant_type"/>
                            <field name="share_percentage"/>
                            <field name="commission_rate"/>
                        </group>
                    </group>
                    <group string="Waterfall">
                        <field name="gross_share"/>
                        <field name="commission_amount"/>
                        <field name="net_due"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- transaction_date, not policy_status or anything effective_range-based, and
         since the ADR 0013 addendum not bind_date either: this view now carries
         written premium, endorsements and return premium, and each settles in the
         period it was recorded. bind_date stays available as a grouping.
         This is what Odoo's native date
         filter widgets (period presets, custom ranges) apply to. No custom filtering
         logic: declaring the field here is what gets the built-in date filter UI. -->
    <record id="view_luxauto_settlement_search" model="ir.ui.view">
        <field name="name">luxauto.settlement.search</field>
        <field name="model">luxauto.settlement</field>
        <field name="arch" type="xml">
            <search>
                <field name="transaction_date"/>
                <field name="policy_number"/>
                <field name="participant_name"/>
                <filter name="filter_transaction_date" date="transaction_date" string="Transaction Date"/>
                <separator/>
                <filter name="groupby_transaction_month" string="Transaction Month"
                        context="{'group_by': 'transaction_date:month'}"/>
                <filter name="groupby_transaction_type" string="Transaction Type"
                        context="{'group_by': 'transaction_type'}"/>
                <filter name="groupby_bind_month" string="Bind Month"
                        context="{'group_by': 'bind_date:month'}"/>
                <filter name="groupby_participant" string="Participant"
                        context="{'group_by': 'participant_name'}"/>
            </search>
        </field>
    </record>

    <record id="action_luxauto_settlement" model="ir.actions.act_window">
        <field name="name">Settlement Report</field>
        <field name="res_model">luxauto.settlement</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_luxauto_settlement_search"/>
    </record>

</odoo>
