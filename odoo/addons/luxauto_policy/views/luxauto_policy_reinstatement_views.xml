<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_luxauto_policy_reinstatement_list" model="ir.ui.view">
        <field name="name">luxauto.policy.reinstatement.list</field>
        <field name="model">luxauto.policy.reinstatement</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false" import="false">
                <field name="new_policy_number"/>
                <field name="prior_policy_number"/>
                <field name="gap_start"/>
                <field name="attestation_reference"/>
                <field name="performed_by"/>
                <field name="created_at"/>
            </list>
        </field>
    </record>

    <record id="view_luxauto_policy_reinstatement_form" model="ir.ui.view">
        <field name="name">luxauto.policy.reinstatement.form</field>
        <field name="model">luxauto.policy.reinstatement</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group string="Reinstatement">
                            <field name="new_policy_number"/>
                            <field name="prior_policy_number"/>
                            <field name="gap_start"/>
                        </group>
                        <group string="Attestation">
                            <field name="attestation_reference"/>
                            <field name="performed_by"/>
                            <field name="created_at"/>
                        </group>
                    </group>
                    <group string="Identifiers">
                        <field name="reinstatement_id"/>
                        <field name="new_policy_id"/>
                        <field name="prior_policy_id"/>
                        <field name="cancellation_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_luxauto_policy_reinstatement" model="ir.actions.act_window">
        <field name="name">Policy Reinstatements</field>
        <field name="res_model">luxauto.policy.reinstatement</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
