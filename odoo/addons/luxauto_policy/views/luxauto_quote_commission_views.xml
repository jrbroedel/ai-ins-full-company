<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_luxauto_quote_commission_list" model="ir.ui.view">
        <field name="name">luxauto.quote.commission.list</field>
        <field name="model">luxauto.quote.commission</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false" import="false">
                <field name="quote_id"/>
                <field name="quote_status"/>
                <field name="broker_channel"/>
                <field name="broker_commission_rate"/>
                <field name="mga_commission_rate"/>
                <field name="premium_amount"/>
                <field name="quoted_at"/>
            </list>
        </field>
    </record>

    <record id="view_luxauto_quote_commission_form" model="ir.ui.view">
        <field name="name">luxauto.quote.commission.form</field>
        <field name="model">luxauto.quote.commission</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group string="Commission">
                            <field name="broker_channel"/>
                            <field name="broker_commission_rate"/>
                            <field name="mga_commission_rate"/>
                        </group>
                        <group string="Quote">
                            <field name="quote_id"/>
                            <field name="premium_amount"/>
                            <field name="quote_status"/>
                            <field name="quoted_at"/>
                        </group>
                    </group>
                    <group string="Identifiers">
                        <field name="application_id"/>
                        <field name="program_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_luxauto_quote_commission" model="ir.actions.act_window">
        <field name="name">Quote Commissions</field>
        <field name="res_model">luxauto.quote.commission</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
