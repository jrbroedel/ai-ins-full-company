<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_luxauto_bind_wizard_form" model="ir.ui.view">
        <field name="name">luxauto.bind.wizard.form</field>
        <field name="model">luxauto.bind.wizard</field>
        <field name="arch" type="xml">
            <form>
                <p>
                    Bind an issued quote into a policy. Enter the quote's ID exactly
                    as it appears in the pipeline database - the quote must be in
                    "issued" status and must not already have a policy.
                </p>
                <group>
                    <field name="quote_id"/>
                    <field name="policy_number"/>
                </group>
                <footer>
                    <button string="Bind" type="object" name="action_bind" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_luxauto_bind_wizard" model="ir.actions.act_window">
        <field name="name">Bind a Quote</field>
        <field name="res_model">luxauto.bind.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
